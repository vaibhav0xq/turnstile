    "@react-three/postprocessing": "^3.1.1",
    "@tanstack/react-query": "^5.102.8",
    "@turnstile/contracts": "workspace:*",
    "@turnstile/identity": "workspace:*",
    "barcode-detector": "^3.2.2",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.5",
    "qrcode": "^1.5.4",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
