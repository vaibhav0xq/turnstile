# Required private RPC and optional browser RPC. On the deployed origins RPC_URL is the Alchemy app URL;
# the fallback lists (comma-separated) take over for reads and receipts when the primary errors or times
# out — transaction sends never fail over (a timed-out send may still have landed).
RPC_URL=http://127.0.0.1:8545
RPC_FALLBACK_URLS=
PUBLIC_RPC_URL=http://127.0.0.1:8545
PUBLIC_RPC_FALLBACK_URLS=
CHAIN_ID=31337
# Defaults to packages/contracts/deployments/<chainId>.json.
DEPLOYMENTS_FILE=
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY
GATE_SIGNER_PRIVATE_KEY=0xYOUR_GATE_PRIVATE_KEY
# Optional bearer token protecting gate check-in.
GATE_TOKEN=
# Never enable a faucet on production.
DRIP_ENABLED=0
DRIP_AMOUNT_WEI=100000000000000000
EXPLORER_URL=
# Optional: header badge for rehearsal origins (e.g. staging); leave empty on the real host.
ENVIRONMENT_LABEL=
# Public origin for absolute URLs in ticket metadata (image, external_url). Set it on every deployed
# relayer; unset, each request's own Host header is used (fine on a laptop, warned about elsewhere).
PUBLIC_ORIGIN=
# Optional extra alias hosts (comma-separated) redirected to PUBLIC_ORIGIN; www.<apex> always is.
REDIRECT_HOSTS=
CORS_ORIGIN=*
PORT=8787
# Optional: also serve the built web app (e.g. ../web/dist) with an SPA fallback.
STATIC_DIR=
# Passport store: Postgres when DATABASE_URL is set (apply db/schema.sql once with `pnpm db:setup`),
# otherwise the JSON file PASSPORT_FILE (default .data/passports-<chainId>.json; `PASSPORT_FILE=` = memory only).
DATABASE_URL=
# PASSPORT_FILE=.data/passports.json