# Required private RPC and optional browser RPC. On the deployed origins RPC_URL is the Alchemy app URL;
# the fallback lists (comma-separated) take over for reads and receipts when the primary errors or times
# out — transaction sends never fail over (a timed-out send may still have landed).
RPC_URL=http://127.0.0.1:8545
RPC_FALLBACK_URLS=
PUBLIC_RPC_URL=http://127.0.0.1:8545
PUBLIC_RPC_FALLBACK_URLS=
CHAIN_ID=31337
# Defaults to packages/contracts/deployments/<chainId>.json.
DEPLOYMENTS_FILE=
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY
GATE_SIGNER_PRIVATE_KEY=0xYOUR_GATE_PRIVATE_KEY
# Optional bearer token protecting gate check-in.
GATE_TOKEN=
# Never enable a faucet on production.
DRIP_ENABLED=0
DRIP_AMOUNT_WEI=100000000000000000
# Spend safety (src/spend-guard.ts; the defaults below apply when unset — see docs/deploy-monad-testnet.md §3a).
# Sponsorship stops while a wallet would drop below its reserve; check the floors in /api/health → sponsorship.
RELAYER_RESERVE_WEI=1000000000000000000
GATE_RESERVE_WEI=200000000000000000
# Sponsored actions per rolling hour / day per class, and per address per day (relay = forwarded fan actions).
RELAY_HOURLY_LIMIT=60
RELAY_DAILY_LIMIT=300
RELAY_DAILY_PER_ADDRESS=24
DRIP_HOURLY_LIMIT=10
DRIP_DAILY_LIMIT=40
DRIP_DAILY_PER_ADDRESS=2
GATE_HOURLY_LIMIT=300
GATE_DAILY_LIMIT=2000
# Transactions queued per wallet before new ones get `BUSY`, and the longest one may wait for its turn.
TX_QUEUE_MAX=8
TX_QUEUE_MAX_WAIT_MS=20000
# Which public X-Forwarded-For entry is the client, counted from the right (1 = the rightmost; internal
# loopback/private hops such as a path router are skipped on their own) — equal to the number of public
# entries a header-less client produces: 1 behind a single ingress (the Replit dev origin), 4 on the
# published Replit origin (Google's load balancer and the platform's proxies append three public addresses
# after the client's), 0 when reached directly (socket address). Client-sent entries never count.
# `GET /api/ip` shows what the limiter sees for you plus the chain's shape (`forwardedPattern`);
# `pnpm preflight` derives the right value from it — too low keys visitors by a proxy's address.
TRUSTED_PROXY_HOPS=1
EXPLORER_URL=
# Optional: header badge for rehearsal origins (e.g. staging); leave empty on the real host.
ENVIRONMENT_LABEL=
# Public origin for absolute URLs in ticket metadata (image, external_url). Set it on every deployed
# relayer; unset, each request's own Host header is used (fine on a laptop, warned about elsewhere).
# Staging keeps its own *.replit.app origin; the final value is https://turnstile.work (www redirects to it).
PUBLIC_ORIGIN=
# Optional extra alias hosts (comma-separated) redirected to PUBLIC_ORIGIN; www.<apex> always is.
REDIRECT_HOSTS=
CORS_ORIGIN=*
PORT=8787
# Optional: also serve the built web app (e.g. ../web/dist) with an SPA fallback.
STATIC_DIR=
# Passport store: Postgres when DATABASE_URL is set (apply db/schema.sql once with `pnpm db:setup`),
# otherwise the JSON file PASSPORT_FILE (default .data/passports-<chainId>.json; `PASSPORT_FILE=` = memory only).
DATABASE_URL=
# PASSPORT_FILE=.data/passports.json