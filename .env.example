# Copy to .env (never committed). Every value here is a placeholder.
# The dev chain needs nothing from this file: `pnpm dev:chain` uses anvil's default keys.

# --- web (apps/web) ---------------------------------------------------------
# Passkeys bind to this host forever: pick the production domain before the first real user.
# Defaults to window.location.hostname, which is right for localhost and for the deployed origin.
VITE_RP_ID=
# Relayer origin. Empty = same origin (the vite dev server proxies /api to RELAYER_URL).
VITE_API_URL=
# Public origin for canonical + Open Graph URLs, e.g. https://example.com (bare origin). Empty = relative
# image URLs and no canonical, which is right until the final domain is live.
VITE_SITE_URL=
RELAYER_URL=http://127.0.0.1:8787

# --- relayer (apps/relayer) — hot wallets, testnet only until audited --------
RPC_URL=https://testnet-rpc.monad.xyz
PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz   # what the browser is told to use
CHAIN_ID=10143                                  # 10143 = Monad testnet, 143 = mainnet, 31337 = anvil
DEPLOYMENTS_FILE=                               # default: packages/contracts/deployments/<CHAIN_ID>.json
RELAYER_PRIVATE_KEY=                            # pays gas for buy / bindDoorKey / list / delist
GATE_SIGNER_PRIVATE_KEY=                        # holds GATE_ROLE; submits checkIn
GATE_TOKEN=                                     # optional bearer token the gate UI must present
DRIP_ENABLED=false                              # testnet only: top up fresh passkey accounts for paid seats
DRIP_AMOUNT_WEI=100000000000000000              # 0.1 MON
EXPLORER_URL=https://testnet.monadexplorer.com
ENVIRONMENT_LABEL=                              # e.g. staging: header badge + tab title on rehearsal origins
PUBLIC_ORIGIN=                                  # absolute origin for metadata image/external_url; set on every deployed relayer
CORS_ORIGIN=http://127.0.0.1:5173
PORT=8787
STATIC_DIR=                                     # optional: serve apps/web/dist from the relayer (single-process deploy)
DATABASE_URL=                                   # Postgres for the passport store (apply apps/relayer/db/schema.sql once:
                                                # `pnpm --filter @turnstile/relayer db:setup`); empty = JSON file at PASSPORT_FILE
# PASSPORT_FILE=.data/passports.json            # without Postgres: default .data/passports-<chainId>.json; `PASSPORT_FILE=` (empty) = memory only

# --- contracts deploy (packages/contracts, see docs/deploy-monad-testnet.md) -
# The deployer is a Foundry keystore (`cast wallet import deployer`), never a variable here.
# Addresses land in packages/contracts/deployments/<chainId>.json — read that, do not copy them around.
GATE_ADDRESS=            # gate EOA; gets GATE_ROLE on the seed events
START_IN=3888000         # seconds until the seed events start (45 d); sales stay open until then
BASE_URI=https://turnstile.example/api/events/
# FORWARDER=             # only when redeploying implementation + factory against an existing forwarder
# MONADSCAN_API_KEY=     # only for the Monadscan verification fallback

# --- indexer (the web app's Live layer) -----------------------------------------
# Envio HyperIndex GraphQL endpoint (Hasura). Build-time for Vite. Unset = the Live surfaces (organiser
# board, city pulse, attendance record, seat provenance) say "unavailable" instead of rendering.
# Local UI work without an indexer: node apps/web/scripts/mock-indexer.mjs (see apps/web/README.md).
VITE_ENVIO_GRAPHQL_URL=

# --- tokens ---------------------------------------------------------------
# USDC: testnet 0x534b2f3A21130d7a60830c2Df862319e593943A3 · mainnet 0x754704Bc059F8C67012fEd69BC8A327a5aafb603
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
