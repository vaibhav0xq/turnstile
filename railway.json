{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build:identity && pnpm --filter @turnstile/relayer typecheck"
  },
  "deploy": {
    "startCommand": "pnpm --filter @turnstile/relayer start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 120,
    "sleepApplication": false
  }
}
